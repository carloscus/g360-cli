{
  "name": "g360-cli",
  "version": "1.19.0",
  "description": "CLI tool for bootstrapping G360 projects with standardized structure, assets, and identity",
  "opencode": {
    "skill": "G360-CLI-SKILL.md",
    "integration": {
      "enabled": true,
      "version": "1.0.0",
      "description": "Integration with OpenCode for AI-assisted development"
    },
    "resources": {
      "skills": "src/assets/config/g360-skills.json",
      "snippets": "src/assets/snippets/snippets.json",
      "templates": "src/assets/templates",
      "components": "src/assets/components",
      "layouts": "src/assets/layouts"
    },
    "commands": {
      "list": "node src/cli.js list",
      "init": "node src/cli.js init",
      "set-skill": "node src/cli.js set-skill",
      "bring": "node src/cli.js bring",
      "audit": "node src/cli.js audit",
      "clean": "node src/cli.js clean",
      "convert": "node src/cli.js convert",
      "signature": "node src/cli.js signature",
      "plan-ui": "node src/cli.js plan-ui",
      "capture": "node src/cli.js capture",
      "review": "node src/cli.js review",
      "set-accent": "node src/cli.js set-accent"
    },
    "designWorkflow": {
      "description": "Loop visual obligatorio para UI: plan -> codigo -> captura -> comparar -> review",
      "steps": [
        "g360 plan-ui <layout> --out UI-PLAN.md (aprobacion del usuario)",
        "implementar el plan en codigo",
        "g360 capture (screenshot de la app Flet)",
        "agente lee el PNG y compara contra UI-PLAN.md, corrige desviaciones",
        "g360 review >= 90/100"
      ]
    },
    "conventions": {
      "framework": "SolidJS",
      "fileExtensions": {
        "components": ".jsx",
        "utilities": ".js"
      },
      "naming": {
        "components": "PascalCase",
        "utilities": "camelCase",
        "styles": "kebab-case"
      },
      "formatting": {
        "indentation": 2,
        "lineLength": 100,
        "quotes": "single",
        "semicolons": true,
        "trailingCommas": true
      },
      "locale": {
        "currency": "S/",
        "language": "es-PE",
        "numberFormat": "comma-thousands,point-decimal"
      },
      "colors": {
        "primary": "#00d084",
        "secondary": "#94a3b8",
        "success": "#22c55e",
        "warning": "#f59e0b",
        "error": "#ef4444"
      }
    }
  }
}
