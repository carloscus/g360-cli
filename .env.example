# Variables de entorno opcionales de g360-cli.
# Todas tienen default: el CLI arranca sin configurar nada.

# Intérprete de Python para los comandos que ejecutan scripts Python.
# Default: python3 en Linux/macOS, python en Windows.
PYTHON=python3

# Nivel de log: debug | info | warn | error
# Default: info
LOG_LEVEL=info
